# ── Security & deployment (required in production) ───────────────────────────
# Signs all JWTs (HS256). Must be >= 32 chars of real randomness — the backend
# refuses to boot when deployed if it is short, low-entropy, or left as this
# placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# APP_URL also sets CORS when CORS_ORIGINS is empty (used for password-reset emails)
# APP_URL=https://your-frontend.example.com
# REDIS_URL=redis://localhost:6379
# CONNECTIONS_ENCRYPTION_KEY=   # optional Fernet key; derived from SECRET_KEY if unset
# ALLOW_PRIVATE_DB_HOSTS=true   # allow VPC / private Postgres or MySQL hosts (SMB self-hosted)
# Optional BigQuery defaults for inline (non-vault) runs:
# BQ_PROJECT_ID=my-gcp-project
# BQ_DATASET=analytics
# SKIP_METRIC_GATE=true         # skip Metric Config HITL gate (tests / automation)

# ── Database paths ───────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
AUTH_DB_PATH=memory/auth.db

# ── Email (password reset + sign-up verification) ────────────────────────────
# RESEND_API_KEY=re_xxx
# Must be a bare address or "Name <addr@domain>" — Resend rejects a bare
# domain in the brackets. The domain must be verified in Resend.
# EMAIL_FROM=DataPilot <noreply@yourdomain.com>
# HTTP timeout for the Resend call. The SDK defaults to 30s, which is a long
# time to hold a signup or password-reset request open on a degraded provider.
# EMAIL_TIMEOUT_SECONDS=10
# AUTH_AUTO_VERIFY_EMAIL=true   # skip verification (dev/tests only)

# ── Auth ─────────────────────────────────────────────────────────────────────
# AUTH_RETURN_TOKENS=false      # omit JWTs from JSON in production (cookies only)
# AUTH_RATE_MAX_ATTEMPTS=10
# AUTH_RATE_WINDOW_SECONDS=60

# ── Retention & backups ────────────────────────────────────────────────────────
# graph.db serialises full query results into every checkpoint and shares the
# volume with auth.db, so unpruned growth eventually takes accounts down too.
# A maintenance pass prunes and snapshots on this interval.
# CHECKPOINT_RETENTION_DAYS=30    # drop threads idle longer than this
# RUN_RETENTION_DAYS=180          # drop run-history rows older than this
# RETENTION_INTERVAL_SEC=86400
# BACKUP_KEEP=7                   # snapshots retained per database
# BACKUP_DIR=                     # defaults to <auth db dir>/backups
#
# Backups cover auth.db and datapilot_memory.db only — graph.db is transient
# run state and is what fills the disk. They live on the same volume, so they
# protect against corruption and bad deletes, NOT against losing the disk.
# Copy them off-box for real disaster recovery.

# ── Observability ──────────────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# Log user content verbatim instead of a redacted reference — analyst task text,
# schema warnings, and exception messages from the agent layer (which quote
# column names and failing SQL). Local debugging only: INFO records become
# Sentry breadcrumbs when SENTRY_DSN is set. Read at call time, so it can be
# flipped on a running process.
# LOG_USER_CONTENT=false

# ── Upload limits ──────────────────────────────────────────────────────────────
UPLOAD_DIR=tmp_uploads
# UPLOAD_MAX_ROWS=1000000
# UPLOAD_MAX_COLS=500

# ── Rate limits & concurrency ─────────────────────────────────────────────────
# MAX_RUNS_PER_WINDOW=5
# RATE_WINDOW_SECONDS=300
# MAX_CONCURRENT_GRAPH_INVOKES=32
# GATE_TIMEOUT_SECONDS=14400

# Per-IP limits key on the leftmost X-Forwarded-For entry by default. That is
# correct ONLY where the edge replaces an inbound header rather than appending
# to it — true on Railway (verified: a request carrying its own
# X-Forwarded-For arrives without that value) and most managed platforms.
# Behind a bare reverse proxy the leftmost entry is client input and is
# spoofable; set TRUSTED_PROXY_HOPS to count from the right instead.
# Note the rightmost entry is not automatically safe either: Railway's edge
# address is public and rotates per request, so keying on it gives every
# request its own bucket and disables rate limiting entirely.
# TRUSTED_PROXY_HOPS=0
# DEBUG_CLIENT_IP=true   # log xff/peer/resolved key for one deploy when unsure

# ── LLM spend caps (USD per UTC day; 0 disables a cap) ────────────────────────
# Guests are budgeted AND rate-limited per IP, not per user_id: /auth/guest
# mints a fresh identity on demand, so a user-keyed limit would reset for free.
# LLM_DAILY_BUDGET_USD=50            # global ceiling — 503 for everyone once hit
# LLM_USER_DAILY_BUDGET_USD=5        # per registered user — 429
# LLM_GUEST_DAILY_BUDGET_USD=1.00    # per guest IP — 429 (~3 runs at Sonnet prices)
# MAX_RUNS_PER_WINDOW=5              # run creations per scope per window
# MAX_RESUMES_PER_WINDOW=30          # gate responses per scope per window (looser: ~5 gates/run)
# RATE_WINDOW_SECONDS=300
# MAX_CONCURRENT_RUNS_PER_GUEST=2    # simultaneous graph invokes per guest IP (0 disables)
# GUEST_UPLOADS_PER_DAY=10           # uploads per guest IP per UTC day (0 disables)
# GUEST_UPLOAD_RETENTION_HOURS=48    # retention pass deletes guest-* upload dirs older than this

ANTHROPIC_API_KEY=your_key_here
# ANTHROPIC_TIMEOUT_SECONDS=120
# ANTHROPIC_MAX_RETRIES=3
FAST_MODEL=claude-sonnet-5
# Optional: set MODEL to override the default LLM for deeper analysis.
# MODEL=your_preferred_anthropic_model
DUCKDB_PATH=data/dau_experiment.db
MEMORY_DB_PATH=memory/datapilot_memory.db
FORECAST_BACKEND=prophet
REVENUE_PER_DAU=0.50
SEMANTIC_CACHE_HARD_THRESHOLD=0.92
SEMANTIC_CACHE_SOFT_THRESHOLD=0.80
LOG_LEVEL=INFO

# Analysis defaults (override to adapt to a different schema without code changes)
DEFAULT_METRIC=dau_rate
DEFAULT_COVARIATE=pre_session_count
DEFAULT_GUARDRAILS=notif_optout,d7_retained,session_count
DEFAULT_SEGMENT_COLS=platform,user_segment
DEFAULT_FUNNEL_STEPS=impression,click,install,d1_retain
SCHEMA_CACHE_PATH=memory/schema_cache.json
BASELINE_DAU=500000
MAX_TOKENS_SQL=512
MAX_TOKENS_NARRATIVE=2048
# Audit budget covers a thinking block plus the JSON on adaptive-thinking models
MAX_TOKENS_AUDIT=8192

# Langfuse observability (optional — tracing is disabled if these are not set)
LANGFUSE_PUBLIC_KEY=pk-lf-your_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Connection secrets ─────────────────────────────────────────────────────────
# Fernet key for encrypting saved warehouse passwords. If unset it is DERIVED
# from SECRET_KEY, which silently couples the two: rotating SECRET_KEY then
# makes every saved connection undecryptable. Set it explicitly.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# On an existing deployment, do NOT generate a fresh one -- pin the key already
# in use, or stored credentials stop decrypting.
# CONNECTIONS_ENCRYPTION_KEY=

# Timeouts for connections to user-supplied database hosts.
# DB_CONNECT_TIMEOUT=10
# DB_READ_TIMEOUT=60
# DB_TEST_TIMEOUT=25
